import logging
from datetime import datetime
from typing import Dict, Any, List

# Configure transparent audit logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

class RedLetterProtocol:
    """
    Core Ethical Engine based on the Red Letter teachings:
    1. Golden Rule / Empathy (Matthew 7:12)
    2. Truth & Integrity (John 8:32 / Matthew 5:37)
    3. Protection of the Vulnerable & Anti-Exploitation (Matthew 25:40)
    4. Discernment & Firm Boundaries (Matthew 10:16)
    """
    def __init__(self):
        self.core_axioms = {
            "empathy_and_reciprocity": "Treat others as you would be treated; do no harm.",
            "uncompromising_truth": "Speak the truth plainly without deception or manipulation.",
            "protect_the_vulnerable": "Reject systemic exploitation, trafficking, and oppression.",
            "firm_discernment": "Be wise as serpents and innocent as doves; do not allow bullying or corruption."
        }
        self.prohibited_patterns = [
            "exploit", "manipulate", "deceive", "oppress", "traffic", "corrupt", "bully"
        ]

    def evaluate_intent(self, payload: Dict[str, Any]) -> Dict[str, Any]:
        content = str(payload.get("content", "")).lower()
        violations = [word for word in self.prohibited_patterns if word in content]
        
        passed = len(violations) == 0
        return {
            "aligned": passed,
            "axioms_verified": list(self.core_axioms.keys()),
            "violations_detected": violations,
            "timestamp": datetime.utcnow().isoformat()
        }


class FairnessAndBiasEngine:
    """
    Detects and mitigates systemic inequality and demographic bias in inputs and outputs.
    """
    def __init__(self):
        self.protected_groups = ["race", "gender", "religion", "age", "socioeconomic_status", "disability"]

    def audit_for_bias(self, data: Dict[str, Any]) -> Dict[str, Any]:
        flagged_terms = []
        text = str(data.get("content", "")).lower()
        
        # Check for exclusionary or discriminatory framing
        exclusionary_markers = ["inferior", "undeserving", "subhuman", "exclude all"]
        for marker in exclusionary_markers:
            if marker in text:
                flagged_terms.append(marker)

        bias_score = len(flagged_terms) / max(len(text.split()), 1)
        return {
            "is_fair": len(flagged_terms) == 0,
            "bias_score": round(bias_score, 4),
            "flagged_markers": flagged_terms
        }


class ExplainabilityEngine:
    """
    Generates a clear, human-readable trace of why Apostil 13 made a specific decision.
    """
    def generate_explanation(self, alignment_result: Dict[str, Any], fairness_result: Dict[str, Any]) -> str:
        reasons = []
        if alignment_result["aligned"]:
            reasons.append("Passed Red Letter Protocol ethical check (Truth, Empathy, Non-Exploitation).")
        else:
            reasons.append(f"Blocked by Red Letter Protocol due to violations: {alignment_result['violations_detected']}.")

        if fairness_result["is_fair"]:
            reasons.append("Passed Fairness audit with zero exclusionary markers.")
        else:
            reasons.append(f"Flagged by Fairness audit for markers: {fairness_result['flagged_markers']}.")

        return " | ".join(reasons)


class HumanOversightQueue:
    """
    Holds high-risk or flagged decisions for human expert review and accountability.
    """
    def __init__(self):
        self.review_queue: List[Dict[str, Any]] = []

    def submit_for_review(self, item: Dict[str, Any], reason: str) -> int:
        ticket_id = len(self.review_queue) + 1
        self.review_queue.append({
            "ticket_id": ticket_id,
            "item": item,
            "reason": reason,
            "status": "PENDING_HUMAN_REVIEW",
            "submitted_at": datetime.utcnow().isoformat()
        })
        logging.warning(f"Ticket #{ticket_id} queued for human oversight: {reason}")
        return ticket_id


class Apostil13:
    """
    Main Sovereign Alignment Controller integrating Red Letter ethics,
    bias mitigation, explainability, and human accountability.
    """
    def __init__(self):
        self.red_letter = RedLetterProtocol()
        self.fairness = FairnessAndBiasEngine()
        self.explainability = ExplainabilityEngine()
        self.oversight = HumanOversightQueue()

    def process_request(self, request_data: Dict[str, Any]) -> Dict[str, Any]:
        # 1. Check Red Letter Value Alignment
        alignment = self.red_letter.evaluate_intent(request_data)
        
        # 2. Check Fairness and Systemic Bias
        fairness = self.fairness.audit_for_bias(request_data)
        
        # 3. Build Transparent Explanation
        explanation = self.explainability.generate_explanation(alignment, fairness)
        
        # 4. Route to Human Oversight if any ethical or fairness check fails
        if not alignment["aligned"] or not fairness["is_fair"]:
            ticket_id = self.oversight.submit_for_review(request_data, explanation)
            return {
                "status": "HALTED_FOR_OVERSIGHT",
                "ticket_id": ticket_id,
                "explanation": explanation,
                "alignment_report": alignment,
                "fairness_report": fairness
            }

        return {
            "status": "APPROVED",
            "explanation": explanation,
            "alignment_report": alignment,
            "fairness_report": fairness,
            "output": f"Processed cleanly under Apostil 13 & Red Letter Protocol: {request_data.get('content')}"
        }


