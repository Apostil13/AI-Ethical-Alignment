      "logic_constraint": "Life preservation is the primary objective.",
      "is_absolute": true,
      "enforcement_action": "BLOCK_IMMEDIATELY"
    },
    "RL-02": {
      "id": "RL-02",
      "title": "Universal Reciprocity",
      "commandment": "Do to others what you would have them do to you",
